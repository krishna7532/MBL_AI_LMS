<%- include('../layouts/header') %>
<div class="auth-card auth-card-wide">
  <div class="auth-logo">
    <img src="/images/mbl-logo.svg" alt="MBL" width="48" height="48">
    <h1>Apply for a 14-day trial</h1>
  </div>
  <p class="auth-subtitle">Your application is reviewed by an admin. If approved, your 14-day trial starts immediately.</p>

  <% if (!user) { %>
  <a href="/auth/google" class="google-btn" id="googleSignIn">
    <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.100 3.600l6.800-6.800C35.800 2.400 30.300 0 24 0 14.600 0 6.500 5.400 2.600 13.200l7.900 6.100C12.400 13.600 17.700 9.500 24 9.500z"/>
      <path fill="#4285F4" d="M46.500 24.500c0-1.600-.1-3.100-.4-4.500H24v9h12.700c-.6 3-2.300 5.500-4.800 7.200l7.500 5.800c4.400-4.100 7.100-10.100 7.100-17.500z"/>
      <path fill="#FBBC05" d="M10.500 28.700c-.5-1.400-.8-3-.8-4.700s.3-3.200.8-4.700l-7.900-6.100C.9 16.400 0 20.100 0 24s.9 7.600 2.600 10.800l7.900-6.100z"/>
      <path fill="#34A853" d="M24 48c6.500 0 11.900-2.100 15.900-5.800l-7.500-5.800c-2.100 1.400-4.900 2.300-8.400 2.300-6.300 0-11.600-4.100-13.500-9.800l-7.900 6.100C6.500 42.600 14.600 48 24 48z"/>
    </svg>
    <span>Continue with Google</span>
  </a>
  <% } else { %>
  <div class="form-row">
    <div class="form-group">
      <span class="form-label">Name</span>
      <p><%= user.name %></p>
    </div>
    <div class="form-group">
      <span class="form-label">Email</span>
      <p><%= user.email %></p>
    </div>
  </div>

  <form id="applicationForm" class="auth-form" method="post" action="/apply" novalidate>
    <div class="form-group">
      <label class="form-label" for="phone">Phone number</label>
      <input class="form-control" id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+91 98765 43210" value="<%= phone %>" required aria-describedby="phoneHelp">
      <span class="form-text" id="phoneHelp">Required. The admin may use it to verify your application. It is not used for automated SMS or WhatsApp messages.</span>
    </div>

    <fieldset class="consent-group">
      <legend class="form-label">Consent</legend>
      <% if (errorMessage) { %>
      <p class="text-danger" role="alert"><%= errorMessage %></p>
      <% } %>
      <div class="form-group">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="consent1" name="consent_terms" value="accepted" required>
          <label class="form-check-label" for="consent1">I agree to the Terms of Use</label>
        </div>
      </div>
      <div class="form-group">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="consent2" name="consent_privacy" value="accepted" required>
          <label class="form-check-label" for="consent2">I agree to the Privacy Policy</label>
        </div>
      </div>
      <span class="form-text">Policy version 1.0. The full Terms and Privacy Policy will be published here after legal review, before launch.</span>
    </fieldset>

    <button type="submit" class="btn btn-primary btn-block btn-lg">Submit application</button>
  </form>
  <% } %>

  <p class="auth-footer">Already approved? <a href="/login">Go to sign-in</a></p>
</div>
<%- include('../layouts/footer') %>

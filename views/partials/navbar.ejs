<header class="navbar">
  <div class="flex items-center gap-2">
    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Open navigation menu" aria-controls="appSidebar" aria-expanded="false">
      <%- icon('menu', 22) %>
    </button>
    <a class="navbar-brand navbar-brand-link" href="<%= isAdminArea ? '/admin' : '/dashboard' %>">
      <img src="/images/mbl-logo.svg" alt="" width="28" height="28">
      <span><%= constants.APP_NAME %></span>
      <% if (isAdminArea) { %><span class="badge badge-primary">Admin</span><% } %>
    </a>
  </div>
  <div class="navbar-actions">
    <% if (!isAdminArea) { %>
    <a class="nav-icon-wrap navbar-icon-link" href="/notifications" aria-label="Notifications<%= unreadCount ? ', ' + unreadCount + ' unread' : '' %>">
      <%- icon('bell', 22) %>
      <% if (unreadCount) { %><span class="notification-badge" data-count="<%= unreadCount %>"><%= unreadCount %></span><% } %>
    </a>
    <% } %>
    <div class="user-dropdown">
      <button type="button" class="user-dropdown-toggle" aria-haspopup="true" aria-expanded="false" aria-label="Account menu for <%= user.name %>">
        <span class="navbar-avatar" aria-hidden="true"><%= fmt.initials(user.name) %></span>
        <span class="user-dropdown-name hide-mobile"><%= user.name %></span>
      </button>
      <div class="user-dropdown-menu" role="menu">
        <% if (isAdminArea) { %>
          <a role="menuitem" href="/dashboard">Learner screens</a>
        <% } else { %>
          <a role="menuitem" href="/profile">Account</a>
          <a role="menuitem" href="/notifications">Notifications</a>
          <a role="menuitem" href="/admin">Admin screens</a>
        <% } %>
        <a role="menuitem" href="/login">Sign-in page</a>
      </div>
    </div>
  </div>
</header>

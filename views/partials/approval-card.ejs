<div class="approval-card">
  <div class="approval-info">
    <h3 class="approval-name"><%= u.name %></h3>
    <p class="text-secondary text-small"><%= u.email %></p>
    <div class="approval-meta">
      <span>Phone: <%= u.phone %></span>
      <span>Applied <%= fmt.dateTime(u.createdAt) %></span>
    </div>
  </div>
  <div class="approval-actions">
    <button type="button" class="btn btn-primary btn-sm btn-approve" data-user-id="<%= u.id %>" data-user-name="<%= u.name %>">Approve</button>
    <button type="button" class="btn btn-secondary btn-sm btn-reject" data-user-id="<%= u.id %>" data-user-name="<%= u.name %>">Reject</button>
  </div>
</div>

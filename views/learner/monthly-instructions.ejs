<%- include('../layouts/header') %>
<%
  const instructions = patternRule && patternRule.rule_value;
  const mcqScoring = instructions && instructions.mcq_scoring;
  const partA = sim.sections.partA;
  const partB = sim.sections.partB;
  const partC = sim.sections.partC;
%>
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/monthly">Monthly Revision</a><span aria-hidden="true">/</span><span aria-current="page"><%= sim.courseName %></span>
</nav>

<div class="simulation-instructions">
  <h1 class="page-title"><%= sim.title %></h1>
  <p class="text-secondary mb-3"><%= sim.duration %> minutes · <%= sim.totalMarks %> marks · every question is compulsory</p>

  <div class="table-responsive mb-3">
    <table class="table">
      <caption class="visually-hidden">Simulation structure</caption>
      <thead><tr><th scope="col">Section</th><th scope="col">Composition</th><th scope="col">Marks</th></tr></thead>
      <tbody>
        <tr><td>Part A</td><td><%= partA.passages %> shared passages, <%= partA.mcqsPerPassage %> linked MCQs each, <%= partA.marksPerMcq %> marks per MCQ</td><td><%= partA.total %></td></tr>
        <tr><td>Part B</td><td><%= partB.questions %> scenario or application questions</td><td><%= partB.total %></td></tr>
        <tr><td>Part C</td><td><%= partC.questions %> doctrinal or critical questions</td><td><%= partC.total %></td></tr>
        <tr><th scope="row">Total</th><td><%= (partA.passages * partA.mcqsPerPassage) + partB.questions + partC.questions %> compulsory response items</td><th><%= sim.totalMarks %></th></tr>
      </tbody>
    </table>
  </div>

  <h2 class="section-title">Instructions</h2>
  <% if (instructions) { %>
    <ul class="instruction-list">
      <% if (instructions.question_numbering) { %><li><%= instructions.question_numbering %></li><% } %>
      <% if (instructions.answer_style) { %><li><%= instructions.answer_style %></li><% } %>
      <% if (instructions.case_law) { %><li><%= instructions.case_law %></li><% } %>
      <% if (instructions.factual_assumptions) { %><li><%= instructions.factual_assumptions %></li><% } %>
      <% if (instructions.compulsory_questions) { %><li>All questions are compulsory.</li><% } %>
      <% if (mcqScoring) { %>
        <li>MCQs score <%= mcqScoring.correct %> for a correct answer, <%= mcqScoring.wrong %> for a wrong answer, and <%= mcqScoring.unanswered %> if unanswered. <%= mcqScoring.negative_marking ? 'Negative marking applies.' : 'There is no negative marking.' %></li>
      <% } %>
      <% if (instructions.autosave) { %><li>Your answers save automatically.</li><% } %>
    </ul>

    <% if (instructions.timer_paused === false) { %>
      <div class="exam-warning" role="note">
        <span aria-hidden="true"><%- icon('clock', 22) %></span>
        <div>
          <strong>The <%= Math.floor(instructions.duration_minutes / 60) %>-hour timer can't be paused.</strong>
          <% if (instructions.auto_submit_on_timeout) { %> When time runs out, your saved answers are submitted automatically.<% } %>
        </div>
      </div>
    <% } %>

    <p class="text-secondary text-small mb-3">
      Exam-pattern configuration: <%= fmt.label(patternRule.confidence || 'unknown') %>
      <% if (patternRule.source) { %> · Source: <%= patternRule.source %><% } %>
      <% if (patternRule.effective_cohort) { %> · Cohort: <%= patternRule.effective_cohort %><% } %>
      · Version <%= patternRule.version %>
    </p>
  <% } else { %>
    <p class="alert alert-warning">Exam instructions are not configured in the database.</p>
  <% } %>

  <% if (hasPlayer) { %>
  <form method="get" action="/monthly/<%= sim.id %>/attempt" class="sim-start-form">
    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" id="confirmTimer" required>
      <label class="form-check-label" for="confirmTimer">I understand the timer runs for 180 continuous minutes and can't be paused.</label>
    </div>
    <button type="submit" class="btn btn-primary btn-lg" id="startSimBtn" disabled>Start simulation</button>
  </form>

  <div class="stage-note">
    <p><strong>Stage 1 preview.</strong> The timer here is a display only and is remembered in this browser. The server-controlled timer, autosave and auto-submit arrive in Stage 2. To see time expire quickly, open the attempt with <code>?demoMinutes=1</code> on the end of the URL.</p>
    <button type="button" class="btn btn-ghost btn-sm" data-reset-preview>Reset preview attempt on this device</button>
  </div>
  <% } else { %>
  <div class="alert alert-warning">
    <span>The database-backed monthly simulation player is not connected yet.</span>
  </div>
  <% } %>
</div>
<%- include('../layouts/footer') %>

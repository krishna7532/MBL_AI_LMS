<%- include('../layouts/header') %>
<div class="page-header">
  <div>
    <h1 class="page-title">Monthly Revision</h1>
    <p class="page-subtitle">One separate three-hour simulation per course. Do them independently, on different days.</p>
  </div>
</div>

<div class="alert alert-info" role="note"><span><%= constants.SIMULATION_PATTERN_NOTICE %></span></div>

<% if (!months.length) { %>
  <div class="empty-state"><p class="empty-state-title">No monthly assessments published yet</p><p class="empty-state-text">Published monthly assessments will appear here.</p></div>
<% } %>

<% months.forEach(function (month) { %>
  <details class="week-block">
    <summary>
      <span class="week-title"><%= month.number === null ? 'Unassigned month' : `Month ${month.number}` %></span>
      <span class="week-meta"><%= month.assessments.length %> assessment<%= month.assessments.length === 1 ? '' : 's' %></span>
    </summary>
    <div class="week-body">
      <div class="courses-grid">
        <% month.assessments.forEach(function (sim) { %>
        <article class="card sim-card">
          <div class="card-body">
            <span class="course-code"><%= sim.courseId %></span>
            <h2 class="course-title"><%= sim.courseName %></h2>
            <p class="text-secondary"><%= sim.title %></p>
            <p class="text-secondary text-small"><%= sim.duration %> minutes · <%= sim.totalMarks %> marks</p>
            <dl class="sim-structure">
              <div><dt>Part A</dt><dd><%= sim.sections.partA.passages %> passages × <%= sim.sections.partA.mcqsPerPassage %> MCQs = <%= sim.sections.partA.total %></dd></div>
              <div><dt>Part B</dt><dd><%= sim.sections.partB.questions %> questions = <%= sim.sections.partB.total %></dd></div>
              <div><dt>Part C</dt><dd><%= sim.sections.partC.questions %> questions = <%= sim.sections.partC.total %></dd></div>
            </dl>
            <% if (sim.bestScore !== null) { %>
              <p class="sim-best">Best score: <strong><%= sim.bestScore %>/<%= sim.totalMarks %></strong> after <%= sim.attempts %> attempt<%= sim.attempts === 1 ? '' : 's' %></p>
            <% } %>
          </div>
          <div class="card-footer flex-between">
            <% if (sim.status === 'available') { %>
              <span class="badge badge-success">Available</span>
              <a class="btn btn-primary btn-sm" href="/monthly/<%= sim.id %>">Read instructions</a>
            <% } else { %>
              <span class="badge badge-muted">Not released yet</span>
              <span class="text-secondary text-small">Appears after admin publishes it</span>
            <% } %>
          </div>
        </article>
        <% }) %>
      </div>
    </div>
  </details>
<% }) %>
<%- include('../layouts/footer') %>

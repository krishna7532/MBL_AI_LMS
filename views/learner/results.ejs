<%- include('../layouts/header') %>
<div class="page-header">
  <div>
    <h1 class="page-title">Results</h1>
    <p class="page-subtitle">MCQs are scored as soon as you submit. Your subjective score and feedback follow once the evaluation finishes.</p>
  </div>
</div>

<% if (results.length) { %>
<div class="card">
  <div class="table-responsive">
    <table class="table">
      <caption class="visually-hidden">Your submitted attempts</caption>
      <thead><tr><th scope="col">Attempt</th><th scope="col">Type</th><th scope="col">Submitted</th><th scope="col">Score</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
      <tbody>
        <% results.forEach(function (r) { %>
        <tr>
          <td><%= r.title %></td>
          <td><span class="badge <%= r.kind === 'monthly' ? 'badge-info' : 'badge-primary' %>"><%= r.kind === 'monthly' ? 'Monthly simulation' : 'Weekly sprint' %></span></td>
          <td><%= fmt.dateTime(r.submittedAt) %></td>
          <td><strong><%= r.earned %>/<%= r.max %></strong></td>
          <td><a class="btn btn-sm btn-secondary" href="/results/<%= r._id %>">Review</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } else { %>
<div class="empty-state card">
  <p class="empty-state-title">No results yet</p>
  <p class="empty-state-text">Submit a weekly sprint and your result appears here.</p>
  <a class="btn btn-primary" href="/dashboard">Go to dashboard</a>
</div>
<% } %>
<%- include('../layouts/footer') %>

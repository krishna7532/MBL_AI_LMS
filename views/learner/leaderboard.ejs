<%- include('../layouts/header') %>
<%
  const wk = lb.weekly;
  const cu = lb.cumulative;
  const p = lb.participation;
%>
<div class="page-header">
  <div>
    <h1 class="page-title">Leaderboard</h1>
    <p class="page-subtitle">Rankings show anonymous handles only. Your name, email, answers and feedback are never shown.</p>
  </div>
</div>

<section class="card mb-4" aria-labelledby="participationHeading">
  <div class="card-body participation">
    <% if (p.optIn) { %>
      <div>
        <h2 id="participationHeading" class="section-title">You're taking part as <strong><%= p.alias %></strong></h2>
        <p class="text-secondary text-small">Your handle and scores appear in the rankings. Participation changes are not currently available here.</p>
      </div>
    <% } else { %>
      <div>
        <h2 id="participationHeading" class="section-title">Leaderboard participation</h2>
        <p class="text-secondary text-small">You are not currently participating. Joining is not currently available here.</p>
      </div>
    <% } %>
  </div>
</section>

<div class="tabs leaderboard-tabs" role="tablist" aria-label="Leaderboard type">
  <button type="button" class="tab-link leaderboard-tab<%= lb.tab === 'weekly' ? ' active' : '' %>" role="tab" id="lbtab-weekly" data-target="panel-weekly" aria-selected="<%= lb.tab === 'weekly' %>" aria-controls="panel-weekly">Weekly</button>
  <button type="button" class="tab-link leaderboard-tab<%= lb.tab === 'cumulative' ? ' active' : '' %>" role="tab" id="lbtab-cumulative" data-target="panel-cumulative" aria-selected="<%= lb.tab === 'cumulative' %>" aria-controls="panel-cumulative">Monthly / Cumulative</button>
</div>

<form class="admin-filters lb-filters" method="get" action="/leaderboard" data-autosubmit>
  <input type="hidden" name="tab" value="<%= lb.tab %>">
  <div class="form-group">
    <label class="form-label" for="attemptToggle">Count attempts</label>
    <select class="form-control" id="attemptToggle" name="attempt">
      <option value="best"<%= cu.attempt === 'best' ? ' selected' : '' %>>Best attempt per assessment</option>
      <option value="first"<%= cu.attempt === 'first' ? ' selected' : '' %>>First attempt per assessment</option>
    </select>
  </div>
  <noscript><button class="btn btn-secondary" type="submit">Apply</button></noscript>
</form>

<!-- WEEKLY -->
<section class="leaderboard-panel<%= lb.tab === 'weekly' ? ' active' : '' %>" id="panel-weekly" role="tabpanel" aria-labelledby="lbtab-weekly">
  <p class="text-secondary text-small mb-2">All completed weekly assessments in academic year <%= lb.academicYear %>. In-progress, expired, and unevaluated attempts are excluded.</p>
  <div class="card">
    <div class="table-responsive">
      <table class="table leaderboard-table">
        <caption class="visually-hidden">Weekly leaderboard: top three handles and your own rank</caption>
        <thead><tr><th scope="col">Rank</th><th scope="col">Handle</th><th scope="col">Assessments</th><th scope="col">Marks</th><th scope="col">Percentage</th></tr></thead>
        <tbody>
          <% wk.top.forEach(function (r) { %>
          <tr class="<%= r.isMe ? 'leaderboard-current-user' : '' %>">
            <td class="rank-cell"><%= r.rank %></td><td class="alias-cell"><%= r.alias %></td><td><%= r.assessmentCount %></td><td><%= r.score.toFixed(2) %>/<%= r.max.toFixed(2) %></td><td><%= r.percentage.toFixed(2) %>%</td>
          </tr>
          <% }) %>
          <% if (p.optIn && wk.me && wk.meOutsideTop) { %>
          <tr class="lb-you-divider"><td colspan="5">Your rank</td></tr>
          <tr class="leaderboard-current-user"><td class="rank-cell"><%= wk.me.rank %></td><td class="alias-cell"><%= wk.me.alias %></td><td><%= wk.me.assessmentCount %></td><td><%= wk.me.score.toFixed(2) %>/<%= wk.me.max.toFixed(2) %></td><td><%= wk.me.percentage.toFixed(2) %>%</td></tr>
          <% } %>
          <% if (!wk.top.length) { %>
          <tr><td colspan="5" class="text-secondary">No completed weekly assessment results are available yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <div class="card-footer text-small">
      <% if (!p.optIn) { %><strong>Not participating.</strong> Join above to appear in the rankings and see your rank.
      <% } else if (!wk.me) { %>You have no eligible completed weekly assessments, so you have no rank here.
      <% } else if (!wk.meOutsideTop) { %>You're in the top three.
      <% } else { %>Your rank: <strong><%= wk.me.rank %></strong>.<% } %>
    </div>
  </div>
</section>

<!-- CUMULATIVE -->
<section class="leaderboard-panel<%= lb.tab === 'cumulative' ? ' active' : '' %>" id="panel-cumulative" role="tabpanel" aria-labelledby="lbtab-cumulative">
  <p class="text-secondary text-small mb-2">Monthly assessment results only, accumulated for academic year <%= lb.academicYear %>. Weekly marks are not included. Equal rounded percentages share a rank. The attempt choice above applies to both leaderboards.</p>

  <div class="card">
    <div class="table-responsive">
      <table class="table leaderboard-table">
        <caption class="visually-hidden">Monthly cumulative leaderboard</caption>
        <thead><tr><th scope="col">Rank</th><th scope="col">Handle</th><th scope="col">Assessments</th><th scope="col">Marks</th><th scope="col">Percentage</th></tr></thead>
        <tbody>
          <% cu.rows.forEach(function (r) { %>
          <tr class="<%= r.isMe && p.optIn ? 'leaderboard-current-user' : '' %>">
            <td class="rank-cell"><%= r.rank %></td><td class="alias-cell"><%= r.alias %></td><td><%= r.assessmentCount %></td><td><%= r.score.toFixed(2) %>/<%= r.max.toFixed(2) %></td><td><%= r.percentage.toFixed(2) %>%</td>
          </tr>
          <% }) %>
          <% if (!cu.rows.length) { %>
          <tr><td colspan="5" class="text-secondary">No completed monthly assessment results are available yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <div class="card-footer flex-between text-small">
      <span><%= p.optIn && cu.me ? 'Your rank: ' + cu.me.rank : 'Not participating.' %></span>
    </div>
  </div>
</section>
<%- include('../layouts/footer') %>

<%- include('../layouts/header') %>
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/courses">Courses</a><span aria-hidden="true">/</span><span aria-current="page"><%= course.name %></span>
</nav>

<div class="page-header">
  <div>
    <span class="course-code"><%= course.code %></span>
    <h1 class="page-title"><%= course.name %></h1>
    <p class="page-subtitle"><%= course.programYear %></p>
  </div>
</div>

<h2 class="section-title">Published weekly sprints</h2>
<% if (course.sprints.length) { %>
  <div class="admin-table">
    <div class="table-responsive">
      <table class="table">
        <caption class="visually-hidden">Published weekly sprints for <%= course.name %></caption>
        <thead><tr><th scope="col">Week</th><th scope="col">Sprint</th><th scope="col">Published</th><th scope="col">Your status</th></tr></thead>
        <tbody>
          <% course.sprints.forEach(function (sprint) { %>
          <tr>
            <td><%= sprint.weekNumber || '—' %></td>
            <td><%= sprint.title %></td>
            <td><%= sprint.publishedAt ? fmt.dateTime(sprint.publishedAt) : '—' %></td>
            <td><span class="badge <%= fmt.approvalClass(sprint.status) %>"><%= fmt.label(sprint.status) %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } else { %>
  <div class="empty-state"><p class="empty-state-title">No sprints published yet</p><p class="empty-state-text">Weekly sprints appear here after they are published.</p></div>
<% } %>
<%- include('../layouts/footer') %>

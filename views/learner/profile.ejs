<%- include('../layouts/header') %>
<%
  const trial = user.trial;
  const state = fmt.accountState(user.accountState);
  const planNames = { annual: 'Annual Plan', completion: 'Completion Plan' };
%>
<div class="page-header">
  <div>
    <h1 class="page-title">Account</h1>
    <p class="page-subtitle">Your identity, access, plans and policies.</p>
  </div>
</div>

<div class="account-grid">
  <section class="card" aria-labelledby="identityHeading">
    <div class="card-header"><h2 id="identityHeading" class="section-title mb-0">Identity</h2></div>
    <div class="card-body">
      <dl class="detail-list">
        <div><dt>Name</dt><dd><%= user.name %></dd></div>
        <div><dt>Email</dt><dd><%= user.email %></dd></div>
        <div><dt>Phone</dt><dd><%= user.phone %></dd></div>
        <div><dt>Sign-in</dt><dd>Google only. There is no password.</dd></div>
      </dl>
    </div>
  </section>

  <section class="card" aria-labelledby="accessHeading">
    <div class="card-header flex-between"><h2 id="accessHeading" class="section-title mb-0">Access</h2><span class="badge <%= state.css %>"><%= state.label %></span></div>
    <div class="card-body">
      <dl class="detail-list">
        <div><dt>Trial started</dt><dd><%= fmt.dateTime(trial.startDate) %></dd></div>
        <div><dt>Trial ends</dt><dd><%= fmt.dateTime(trial.endDate) %></dd></div>
        <div><dt>Days left</dt><dd><%= trial.daysRemaining %></dd></div>
      </dl>
      <p class="text-secondary text-small mt-3">During the trial you can open content published inside the trial window. When it ends, protected content is blocked until a plan is active.</p>
    </div>
  </section>
</div>

<section id="plans" class="mt-4" aria-labelledby="plansHeading">
  <h2 id="plansHeading" class="section-title">Plans</h2>
  <% if (subscription) { %>
  <div class="card mb-3">
    <div class="card-body">
      <h3 class="section-title">Active subscription: <%= planNames[subscription.plans.code] || subscription.plans.code %></h3>
      <p class="text-secondary">Access is active through <%= fmt.date(subscription.ends_at) %>.</p>
    </div>
  </div>
  <% } %>
  <p class="text-danger" data-payment-status role="status" hidden></p>
  <div class="plans-grid">
    <% plans.forEach(function (plan) { %>
    <article class="card plan-card">
      <div class="card-body">
        <h3 class="plan-name"><%= plan.name %></h3>
        <p class="plan-price"><%= fmt.rupees(plan.price) %> <span class="plan-duration">for <%= plan.duration %>, paid upfront</span></p>
        <p class="text-secondary text-small mb-3"><%= plan.description %></p>
        <ul class="plan-features">
          <% plan.features.forEach(function (f) { %><li><%- icon('check', 16) %> <%= f %></li><% }) %>
        </ul>
      </div>
      <div class="card-footer">
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" id="refund-<%= plan.code %>" data-refund-ack>
          <label class="form-check-label" for="refund-<%= plan.code %>"><%= constants.REFUND_DISCLOSURE %></label>
        </div>
        <button
          type="button"
          class="btn btn-primary btn-block"
          data-payment-plan="<%= plan.code %>"
          data-plan-name="<%= plan.name %>"
        >Buy <%= fmt.rupees(plan.price) %></button>
      </div>
    </article>
    <% }) %>
  </div>
  <% if (!plans.length) { %>
  <p class="text-secondary">No plans are available for purchase right now.</p>
  <% } %>
  <p class="text-secondary text-small mt-3"><%= constants.REFUND_DISCLOSURE %></p>
  <p class="text-secondary text-small">Paid access starts only after the server confirms your payment. Tax treatment and the contracting entity are still to be confirmed before paid launch.</p>
</section>

<div class="account-grid mt-4">
  <section class="card" aria-labelledby="paymentsHeading">
    <div class="card-header"><h2 id="paymentsHeading" class="section-title mb-0">Payment history</h2></div>
    <div class="card-body">
      <% if (paymentHistory.length) { %>
      <ul class="result-list">
        <% paymentHistory.forEach(function (payment) { %>
        <li>
          <span>
            <span class="result-list-title"><%= planNames[payment.plans && payment.plans.code] || 'Plan payment' %></span>
            <span class="result-list-meta"><%= fmt.dateTime(payment.paid_at || payment.created_at) %> · <%= fmt.label(payment.state) %></span>
          </span>
          <span class="sprint-score"><%= fmt.rupees(Number(payment.amount)) %></span>
        </li>
        <% }) %>
      </ul>
      <% } else { %>
      <p class="text-secondary">No payments yet.</p>
      <% } %>
    </div>
  </section>

  <section class="card" aria-labelledby="policiesHeading">
    <div class="card-header"><h2 id="policiesHeading" class="section-title mb-0">Policies you accepted</h2></div>
    <div class="card-body">
      <dl class="detail-list">
        <div><dt>Terms of Use</dt><dd>Version <%= user.consents.terms.version %>, accepted <%= fmt.date(user.consents.terms.date) %></dd></div>
        <div><dt>Privacy Policy</dt><dd>Version <%= user.consents.privacy.version %>, accepted <%= fmt.date(user.consents.privacy.date) %></dd></div>
      </dl>
    </div>
  </section>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<%- include('../layouts/footer') %>

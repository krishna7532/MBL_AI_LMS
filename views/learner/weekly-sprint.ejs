<%- include('../layouts/header') %>
<%
  const s = page.sprint;
  const st = fmt.sprintState(s.status);
%>
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/dashboard">Dashboard</a><span aria-hidden="true">/</span><span>Week <%= s.weekNumber %></span><span aria-hidden="true">/</span><span aria-current="page"><%= s.courseName %></span>
</nav>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= s.courseName %></h1>
    <p class="page-subtitle"><%= s.title %></p>
  </div>
  <div class="page-actions">
    <span class="badge badge-muted"><%= s.weekday %> · Week <%= s.weekNumber %></span>
    <span class="sprint-status <%= st.css %>"><%= st.label %></span>
  </div>
</div>

<div class="alert alert-info" role="note">
  <span><strong><%= constants.REVISION_ONLY %>.</strong> A sprint is 30 minutes: 15 minutes of notes, 10 minutes of MCQs and a 5-minute subjective outline. Maximum 40 marks.</span>
</div>

<% if (!page.hasContent) { %>
  <div class="empty-state card">
    <div class="empty-state-icon" aria-hidden="true"><%- icon('info', 40) %></div>
    <h2 class="empty-state-title">No preview content for this sprint</h2>
    <p class="empty-state-text">Stage 1 has full mock content for the Contract Law Week 7 sprint only. Real releases supply the notes, MCQs and subjective question for every course.</p>
    <div class="flex gap-2 justify-center">
      <% if (page.resultHref) { %><a class="btn btn-secondary" href="<%= page.resultHref %>">View sample result</a><% } %>
      <a class="btn btn-primary" href="/weekly/sprint_w07_C01">Open the Contract Law sprint</a>
    </div>
  </div>
<% } else { %>

<ol class="sprint-steps" aria-label="Sprint steps">
  <li class="step step-notes"><span class="step-name">Revision notes</span><span class="step-time">15 min</span></li>
  <li class="step step-mcq"><span class="step-name">15 MCQs</span><span class="step-time">10 min</span></li>
  <li class="step step-subjective"><span class="step-name">Subjective outline</span><span class="step-time">5 min</span></li>
</ol>

<div class="sprint-tabs" role="tablist" aria-label="Sprint sections">
  <button type="button" class="sprint-tab-link active" role="tab" id="tab-notes" data-tab="notes" aria-selected="true" aria-controls="pane-notes">Notes</button>
  <button type="button" class="sprint-tab-link" role="tab" id="tab-mcq" data-tab="mcq" aria-selected="false" aria-controls="pane-mcq" tabindex="-1">MCQs <span class="tab-count" id="mcqTabCount">0/15</span></button>
  <button type="button" class="sprint-tab-link" role="tab" id="tab-subjective" data-tab="subjective" aria-selected="false" aria-controls="pane-subjective" tabindex="-1">Subjective</button>
</div>

<!-- NOTES -->
<section class="sprint-tab-pane active" id="pane-notes" role="tabpanel" aria-labelledby="tab-notes" data-tab="notes">
  <article class="notes-reader">
    <header class="notes-header">
      <h2><%= page.notes.title %></h2>
      <p class="text-secondary text-small">Reading time: <%= page.notes.readTime %></p>
    </header>
    <div class="notes-content">
      <%- page.notes.html %>
    </div>
    <footer class="notes-footer">
      <p class="notes-assumption"><%= constants.REVISION_ASSUMPTION %></p>
      <p class="notes-authorship"><%= constants.AUTHORSHIP_NOTICE %></p>
      <button type="button" class="btn btn-primary" id="completeNotesBtn">Mark notes complete and start MCQs</button>
    </footer>
  </article>
</section>

<!-- MCQ -->
<section class="sprint-tab-pane" id="pane-mcq" role="tabpanel" aria-labelledby="tab-mcq" data-tab="mcq" hidden>
  <div class="mcq-player">
    <div class="player-progress">
      <div class="progress-bar" role="progressbar" aria-label="MCQs answered" aria-valuenow="0" aria-valuemin="0" aria-valuemax="15"><div class="progress-fill" style="width: 0%"></div></div>
      <span class="text-secondary text-small" id="mcqProgressText">0 of 15 answered</span>
    </div>
    <div class="player-grid">
      <div>
        <div class="question-container" aria-live="polite">
          <%- include('../partials/loading', { message: 'Loading questions…' }) %>
          <noscript><p class="alert alert-warning">JavaScript is needed to answer the MCQs in this preview.</p></noscript>
        </div>
        <div class="question-nav">
          <button type="button" class="btn btn-secondary" id="prevQuestionBtn">Previous</button>
          <button type="button" class="btn btn-primary" id="nextQuestionBtn">Next</button>
        </div>
      </div>
      <aside class="player-side" aria-label="Question navigator">
        <h3 class="player-side-title">Questions</h3>
        <div class="question-dots" role="group" aria-label="Jump to question"></div>
        <p class="text-secondary text-small mt-3">Correct answers and explanations appear after you submit.</p>
      </aside>
    </div>
  </div>
</section>

<!-- SUBJECTIVE -->
<section class="sprint-tab-pane" id="pane-subjective" role="tabpanel" aria-labelledby="tab-subjective" data-tab="subjective" hidden>
  <div class="question-card subjective-card">
    <div class="question-header">
      <span class="question-number" aria-hidden="true">S</span>
      <div>
        <p class="question-prompt subjective-prompt"><%= page.subjective.prompt %></p>
        <span class="question-origin-badge"><%= page.subjective.badge %></span>
        <span class="question-origin-badge"><%= page.subjective.marks %> marks</span>
      </div>
    </div>

    <div class="subjective-editor" data-max="<%= page.limits.subjectiveMaxChars %>" data-warn="<%= page.limits.subjectiveWarnChars %>">
      <label class="form-label" for="subjectiveAnswer">Your answer</label>
      <p class="form-text" id="answerHelp">Number your sub-parts, for example (a), (b), (c). The expected answer and marking scheme stay hidden until you submit.</p>
      <textarea id="subjectiveAnswer" name="answer" class="form-control" rows="12" aria-describedby="answerHelp answerCounter"></textarea>
      <div class="char-counter" id="answerCounter" aria-live="polite">0 / <%= page.limits.subjectiveMaxChars %></div>

      <label class="form-label mt-3" for="assumptions">Assumptions (optional)</label>
      <p class="form-text" id="assumptionsHelp">State any additional facts you assumed.</p>
      <textarea id="assumptions" name="assumptions" class="assumptions-field" rows="3" maxlength="<%= page.limits.assumptionsMaxChars %>" aria-describedby="assumptionsHelp"></textarea>
      <p class="save-indicator" id="saveIndicator" aria-live="polite">Draft saved on this device only.</p>
    </div>
  </div>
</section>

<!-- SUBMIT BAR -->
<div class="submit-bar">
  <p class="submit-bar-status" id="submitStatus" aria-live="polite">MCQs answered: 0 of 15. Subjective: not started.</p>
  <button type="button" class="btn btn-primary" id="submitSprintBtn" data-modal-open="submitSprintModal">Submit sprint</button>
</div>

<div class="modal" id="submitSprintModal" role="dialog" aria-modal="true" aria-labelledby="submitSprintTitle">
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <div class="modal-header"><h2 id="submitSprintTitle" class="modal-title">Submit this sprint?</h2></div>
    <div class="modal-body">
      <p id="submitSummary"></p>
      <p class="text-secondary text-small mt-2">After you submit, you can't change this attempt. You can retake the sprint later as a new attempt.</p>
      <div class="alert alert-warning mt-3"><span><strong>Stage 1 preview.</strong> Your answers are not scored or saved on a server. Submitting opens a sample result built from mock answers.</span></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-modal-close>Keep working</button>
      <button type="button" class="btn btn-primary" id="confirmSubmitBtn">Submit and view sample result</button>
    </div>
  </div>
</div>

<%
  // Learner-safe payload: options and prompts only. No correct answers or explanations (PRD §15.1).
  const clientData = { sprintId: s.id || s._id, mcqs: page.mcqs, subjectiveMax: page.limits.subjectiveMaxChars, resultUrl: '/results/attempt_preview' };
%>
<script type="application/json" id="mcqData"><%- fmt.json(clientData) %></script>
<% } %>
<%- include('../layouts/footer') %>

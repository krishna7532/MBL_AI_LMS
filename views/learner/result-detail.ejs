<%- include('../layouts/header') %>
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/results">Results</a><span aria-hidden="true">/</span><span aria-current="page"><%= result.courseName %></span>
</nav>

<div class="result-page">
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <%= result.courseName %> · <%= result.kind === 'monthly' ? 'Monthly simulation' : 'Week ' + result.weekNumber + ' sprint' %>
      </h1>
      <p class="page-subtitle">Attempt <%= result.attemptNumber %><% if (result.submittedAt) { %> · submitted <%= fmt.dateTime(result.submittedAt) %><% } %></p>
    </div>
  </div>

  <section class="result-summary" aria-labelledby="scoreHeading">
    <div class="result-score-circle">
      <span class="score-value"><%= result.total.earned %></span>
      <span class="score-label"><%= result.total.provisional ? 'provisional MCQ score' : 'out of ' + result.total.max %></span>
    </div>
    <div class="result-breakdown">
      <h2 id="scoreHeading" class="section-title"><%= result.total.provisional ? 'Objective score' : 'Final score' %></h2>
      <div class="result-section">
        <div class="result-section-header">
          <span>MCQs</span><span><%= result.objective.earned %>/<%= result.objective.max %></span>
        </div>
        <p class="text-secondary text-small mt-1">Scored on the server from your submitted answers.</p>
      </div>
      <div class="result-section">
        <div class="result-section-header">
          <span>Written answers</span>
          <span><%= result.subjective.status === 'evaluated' ? result.subjective.earned + '/' + result.subjective.max : 'Pending evaluation' %></span>
        </div>
        <% if (result.subjective.status === 'evaluation_pending') { %>
          <p class="text-secondary text-small mt-1"><%= result.subjective.pendingCount %> response<%= result.subjective.pendingCount === 1 ? '' : 's' %> awaiting evaluation. No zero score has been assigned while evaluation is pending.</p>
        <% } %>
      </div>
    </div>
  </section>

  <% if (result.subjective.status === 'evaluation_pending') { %>
    <div class="alert alert-info" role="status"><span>Your objective score is provisional. The combined result will be available after written evaluation completes.</span></div>
  <% } %>
  <p class="text-secondary text-small">Submission: <%= result.submittedVia === 'automatic' ? 'automatic at the deadline' : 'manual' %> · Attempt state: <%= fmt.label(result.state) %></p>
<% if (result.subjectiveFeedback && result.subjectiveFeedback.length > 0) { %>
  <section class="result-feedback mt-6" aria-labelledby="feedbackHeading">
    <h2 id="feedbackHeading" class="section-title">Written answer feedback</h2>

    <% for (const item of result.subjectiveFeedback) { %>
      <div class="result-section mb-4">

        <div class="result-section-header">
          <span>
            <% if (item.questionNumber) { %>Q<%= item.questionNumber %> — <% } %>
            <em class="text-secondary"><%= item.promptPreview %><% if (item.promptPreview.length >= 200) { %>…<% } %></em>
          </span>
          <span>
            <% if (item.score !== null) { %>
              <%= item.score %>/<%= item.maxMarks %>
            <% } else { %>
              —/<%= item.maxMarks %>
            <% } %>
          </span>
        </div>

        <% if (item.requiresHumanReview) { %>
          <div class="alert alert-info mt-2" role="note">
            <span>This answer has been flagged for human review. The score shown may be revised.</span>
          </div>
        <% } %>

        <% if (item.summary) { %>
          <p class="mt-2"><%= item.summary %></p>
        <% } %>

        <% if (item.criterionMarks && item.criterionMarks.length > 0) { %>
          <table class="result-table mt-2" aria-label="Criterion breakdown">
            <thead>
              <tr><th>Criterion</th><th>Awarded</th><th>Max</th></tr>
            </thead>
            <tbody>
              <% for (const c of item.criterionMarks) { %>
                <tr>
                  <td><%= c.criterion %></td>
                  <td><%= c.awarded %></td>
                  <td><%= c.max %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        <% } %>

        <% if (item.strengths && item.strengths.length > 0) { %>
          <div class="mt-2">
            <p class="text-small text-secondary">Strengths</p>
            <ul>
              <% for (const point of item.strengths) { %>
                <li><%= point %></li>
              <% } %>
            </ul>
          </div>
        <% } %>

        <% if (item.missingPoints && item.missingPoints.length > 0) { %>
          <div class="mt-2">
            <p class="text-small text-secondary">Missing points</p>
            <ul>
              <% for (const point of item.missingPoints) { %>
                <li><%= point %></li>
              <% } %>
            </ul>
          </div>
        <% } %>

        <% if (item.incorrectPoints && item.incorrectPoints.length > 0) { %>
          <div class="mt-2">
            <p class="text-small text-secondary">Incorrect points</p>
            <ul>
              <% for (const point of item.incorrectPoints) { %>
                <li><%= point %></li>
              <% } %>
            </ul>
          </div>
        <% } %>

      </div>
    <% } %>
  </section>
<% } %>
  <div class="flex gap-2 mt-4">
    <a class="btn btn-primary" href="/dashboard">Back to dashboard</a>
    <a class="btn btn-secondary" href="<%= result.kind === 'monthly' ? '/monthly' : '/weekly' %>"><%= result.kind === 'monthly' ? 'Monthly Revision' : 'Weekly sprints' %></a>
    <a class="btn btn-secondary" href="<%= result.kind === 'monthly' ? '/monthly/' + result.assessmentId + '/attempt?retake=1' : '/weekly/' + result.assessmentId + '?retake=1' %>">Retake exam</a>
  </div>
</div>
<%- include('../layouts/footer') %>

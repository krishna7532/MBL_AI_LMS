# Copy to .env for local development. .env is git-ignored.
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-in-stage-2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Copy to .env for local development. .env is git-ignored.
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-in-stage-2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# PostgreSQL (use percent-encoding for reserved characters in credentials)
DATABASE_URL=postgresql://your-database-user:your-database-password@localhost:5432/mbl-ai?schema=public

# AWS S3 release archive storage
AWS_REGION=your-aws-region
AWS_S3_BUCKET_NAME=your-private-bucket-name

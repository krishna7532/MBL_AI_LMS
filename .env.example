# PostgreSQL
DB_USER=your-database-user
DB_HOST=localhost
DB_NAME=mbl_ai_lms
DB_PASSWORD=your-database-password
DB_PORT=5432

# AWS S3 release archive storage
AWS_REGION=your-aws-region
AWS_S3_BUCKET_NAME=your-private-bucket-name
